<!-- ============ ОБЩЕЕ: ВСПЛЫВАЮЩЕЕ ОКНО «ОБРАТНЫЙ ЗВОНОК» ============ -->
<div class="modal" id="callback">
  <div class="modal__back" data-close></div>
  <div class="modal__box" role="dialog" aria-modal="true" aria-labelledby="cbTitle">
    <button class="modal__x" data-close aria-label="Закрыть">&times;</button>
    <h2 id="cbTitle">Обратный звонок</h2>
    <p>Короткая подпись: в какой срок перезвонят.</p>
    <form class="mform" onsubmit="return false">
      <input class="mfield" placeholder="Имя">
      <input class="mfield" placeholder="Телефон">
      <input class="mfield" placeholder="Удобное время">
      <label class="magree"><i></i><span>Согласие на обработку персональных данных</span></label>
      <button class="btn btn--fill">Жду звонка</button>
    </form>
  </div>
